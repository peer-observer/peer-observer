    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "repeat references in the new table",
          "description": "Bitcoin Core stores one entry per address and lets up to eight new buckets reference it (nRefCount, capped at ADDRMAN_NEW_BUCKETS_PER_ADDRESS = 8). Every reference occupies a position, and getrawaddrman reports it with the same address, port, services, time and source - source being the peer that first announced the address, not the one that caused the extra reference. A re-announcement with a newer timestamp, from a peer in a different source group, has a one in 2^nRefCount chance of claiming one more bucket. This counts the references beyond the first, so it is the number of the 65536 new positions that hold no address the table does not already have.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "P1809F7CD0C75ACF3"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (host) (peerobserver_rpc_getrawaddrman_entries{table=\"new\"} - peerobserver_rpc_getrawaddrman_distinct_entries{table=\"new\"})",
                        "legendFormat": "{{host}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
